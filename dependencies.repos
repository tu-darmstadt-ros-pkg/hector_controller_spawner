repositories:
  hector_ros_controllers:
    type: git
    url: https://github.com/tu-darmstadt-ros-pkg/hector_ros_controllers.git
    version: jazzy
  hector_ros2_utils:
    type: git
    url: https://github.com/tu-darmstadt-ros-pkg/hector_ros2_utils.git
    version: jazzy
  hector_testing_utils:
    type: git
    url: https://github.com/Joschi3/hector_testing_utils.git
    version: main
  # TODO: move to jazzy-fix once feature/auto_and_force_auto_controller_switching is merged.
  ros2_control:
    type: git
    url: https://github.com/tu-darmstadt-ros-pkg/ros2_control.git
    version: feature/auto_and_force_auto_controller_switching
